FLASK_ENV=development
FLASK_DEBUG=1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
CORS_ORIGINS=*

MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://eodhd.com/api/real-time
MARKET_CACHE_TTL_SECONDS=900
MARKET_REQUEST_TIMEOUT_SECONDS=8
ENABLE_MARKET_MOCK_FALLBACK=true
MARKET_CACHE_DB_PATH=backend/data/market_cache.db

NEWS_PROVIDER=google_news_rss
NEWS_CACHE_TTL_SECONDS=900
ANALYSIS_CACHE_TTL_SECONDS=86400

AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=
ENABLE_DEV_ANALYSIS_FALLBACK=1

# Catatan keamanan:
# - MARKET_DATA_API_KEY dan OPENAI_API_KEY hanya untuk backend.
# - Jangan simpan secret apa pun di Flutter atau di source Dart.
# - Backend market hanya menerima symbol saham, misalnya BBCA atau BBCA.JK.
# - Data pasar bersifat estimasi dan bukan rekomendasi investasi.
